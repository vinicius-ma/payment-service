# AWS Academy Learner Lab Credentials
# Obtenha estas credenciais do AWS Academy:
# 1. Acesse AWS Academy Learner Lab
# 2. Clique em "AWS Details"
# 3. Clique em "Show" ao lado de "AWS CLI"
# 4. Copie as credenciais abaixo

AWS_ACCESS_KEY_ID=ASIA...
AWS_SECRET_ACCESS_KEY=...
AWS_SESSION_TOKEN=IQoJb3JpZ2luX2VjE...
AWS_REGION=us-east-1

# AWS Resources ARNs
# Após criar os recursos na AWS, atualize os valores abaixo:

# Nome da fila SQS
ORDER_PAYMENTS_QUEUE_NAME=order-payments-queue

# ARN do tópico SNS
# Formato: arn:aws:sns:us-east-1:123456789012:payment-status
PAYMENT_STATUS_TOPIC_ARN=arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:payment-status
